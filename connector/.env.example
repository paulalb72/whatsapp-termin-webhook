# Variablen des Bot-Connectors. In Coolify unter "Environment Variables" der Connector-Ressource eintragen.
# Zufallswerte erzeugen:  openssl rand -hex 32   (keine "$"-Zeichen verwenden)

# Öffentliche Adresse des Connectors, OHNE /mcp am Ende. Claude verbindet sich mit <PUBLIC_URL>/mcp.
PUBLIC_URL=https://connector.paulalberts.de

# Passwort, das der Kollege beim Verbinden auf der Login-Seite eingibt (mind. 12 Zeichen).
# Ändern = alle bestehenden Anmeldungen sofort ungültig (danach Redeploy).
CONNECTOR_PASSWORD=

# GitHub Fine-grained Token, NUR für das Bot-Repo, Berechtigung "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=paulalb72/whatsapp-termin-webhook
GITHUB_BRANCH=main

# Coolify-API: Adresse der Coolify-Oberfläche, API-Token (read, read:sensitive, write, deploy)
# und UUID der Bot-Ressource (steht in der Coolify-URL der Ressource hinter /application/).
COOLIFY_URL=https://coolify.paulalberts.de
COOLIFY_TOKEN=
COOLIFY_APP_UUID=

# Öffentliche URL des Bots und sein WEBHOOK_TOKEN (für Testaufrufe geschützter Endpoints).
BOT_URL=https://whasup.paulalberts.de
BOT_TOKEN=

# Zeitzone für Zeitangaben in den Antworten.
TIMEZONE=Europe/Berlin
