# Alle Variablen des Dienstes. In Coolify werden sie unter "Environment Variables" eingetragen
# (Coolify erkennt sie automatisch aus docker-compose.yml). Für lokale Tests: cp .env.example .env
# Tokens/Passwörter erzeugen:  openssl rand -hex 32   (keine "$"-Zeichen verwenden)

# ---------- Pflicht ----------
# Geheimer Token, den das Akquise-Tool mitschickt (mind. 16 Zeichen).
# Wird akzeptiert als Header "Authorization: Bearer <token>" oder als ?token=<token>.
WEBHOOK_TOKEN=

# API-Key für WAHA (wird von WAHA und vom Webhook-Dienst verwendet).
WAHA_API_KEY=

# Login für WAHA-Dashboard und Swagger (nur per SSH-Tunnel erreichbar).
WAHA_DASHBOARD_PASSWORD=

# ---------- Nach dem QR-Scan eintragen ----------
# ID der Ziel-Gruppe (endet auf @g.us). Ermitteln mit:  python list_groups.py  (im webhook-Container)
# Solange leer, lehnt der Webhook Aufrufe mit 503 ab.
WAHA_GROUP_ID=

# ---------- Optional (leer = Default) ----------
# JSON-Feldnamen im Webhook-Body für Person und Unternehmen.
FIELD_WER=wer
FIELD_UNTERNEHMEN=unternehmen

# Nachrichtentext. Platzhalter: {wer} und {unternehmen}. \n = Zeilenumbruch,
# WhatsApp-Formatierung: *fett*, _kursiv_. Leer = Default:
#   🎉 *NEUER TERMIN!* 🎉
#
#   👤 *{wer}* hat gerade einen Termin mit
#   🏢 *{unternehmen}* gemacht.
#
#   🔥 Stark, weiter so! 💪
# Beispiel für einen eigenen Text:
#   MESSAGE_TEMPLATE=📅 *Termin!*\n{wer} ➜ {unternehmen}
MESSAGE_TEMPLATE=

# Maximale Länge pro Feld (längere Eingaben werden abgeschnitten).
MAX_FIELD_LENGTH=100

# Gleicher Webhook (gleiches WER + UNTERNEHMEN) innerhalb dieser Sekunden wird nur einmal gesendet.
DEDUP_SECONDS=60

# WAHA-Image-Tag: "arm" für ARM-Server (Hetzner CAX), "latest" für x86 (CX/CPX).
WAHA_IMAGE_TAG=arm

# Benutzername für das WAHA-Dashboard.
WAHA_DASHBOARD_USERNAME=admin
